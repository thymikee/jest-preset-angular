{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",
    "module": "Node18",
    "moduleResolution": "Node16",
    "removeComments": true,
    "stripInternal": true,
    "declaration": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["**/*.spec.ts", "src/transformers/jit_transform.js"]
}
